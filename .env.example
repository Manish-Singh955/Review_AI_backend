PORT=5000
# Local MongoDB or a MongoDB Atlas connection string, e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/reviewai?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/reviewai
JWT_SECRET=change_this_secret
FRONTEND_URL=http://localhost:5173
OPENAI_API_KEY=your_openai_api_key_here
AI_MODEL=gpt-4o-mini
AI_PROVIDER=openai
# Optional: OpenAI-compatible endpoint and request timeout (ms)
# OPENAI_BASE_URL=
AI_TIMEOUT_MS=20000
# Ratings at or below this value go to private feedback instead of AI drafts
LOW_RATING_THRESHOLD=3
